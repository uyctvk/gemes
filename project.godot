; LIVING WORLD — native desktop prototype
config_version=5

[application]
config/name="LIVING WORLD"
config/version="0.1.0"
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://game/assets/icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.19, 0.21, 1)

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false

